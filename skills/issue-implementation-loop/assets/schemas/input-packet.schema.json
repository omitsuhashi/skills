{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_evidence": {
      "additionalProperties": false,
      "properties": {
        "actor_expression": {"minLength": 1, "pattern": "\\S", "type": "string"},
        "approved_at": {"format": "date-time", "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$", "type": "string"},
        "decision": {"const": "approved"},
        "scope": {
          "additionalProperties": false,
          "properties": {
            "acceptance_criteria": {"const": true},
            "accepted_decisions": {"const": true},
            "non_goals": {"const": true},
            "remote_policy": {"const": true},
            "stop_conditions": {"const": true},
            "verification": {"const": true}
          },
          "required": ["accepted_decisions", "non_goals", "acceptance_criteria", "verification", "remote_policy", "stop_conditions"],
          "type": "object"
        },
        "subject": {"const": "spec_binding"}
      },
      "required": ["decision", "subject", "actor_expression", "approved_at", "scope"],
      "type": "object"
    },
    "artifact_root": {"minLength": 1, "pattern": "^(?![/~])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*\\x00)[^/]+(?:/[^/]+)*$", "type": "string"},
    "delivery_intent": {"enum": ["local_only", "per_action", "batch_draft_prs", "batch_issue_prs"]},
    "epic_id": {"pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "type": "string"},
    "schema_version": {"const": 2},
    "spec_binding": {
      "additionalProperties": false,
      "properties": {
        "path": {"minLength": 1, "pattern": "^(?![/~])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*\\x00)[^/]+(?:/[^/]+)*$", "type": "string"},
        "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["path", "sha256"],
      "type": "object"
    },
    "work_items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "acceptance_criteria": {"items": {"minLength": 1, "pattern": "\\S", "type": "string"}, "minItems": 1, "type": "array"},
          "dependencies": {"items": {"pattern": "^[A-Z0-9]+-[0-9]+$", "type": "string"}, "type": "array"},
          "id": {"pattern": "^[A-Z0-9]+-[0-9]+$", "type": "string"},
          "non_goals": {"items": {"minLength": 1, "pattern": "\\S", "type": "string"}, "minItems": 1, "type": "array"},
          "source": {
            "additionalProperties": false,
            "properties": {"path": {"minLength": 1, "pattern": "^(?![/~])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*\\x00)[^/]+(?:/[^/]+)*$", "type": "string"}, "type": {"const": "local"}},
            "required": ["type", "path"],
            "type": "object"
          },
          "title": {"minLength": 1, "pattern": "\\S", "type": "string"},
          "verification": {"items": {"minLength": 1, "pattern": "\\S", "type": "string"}, "minItems": 1, "type": "array"},
          "write_scope": {"items": {"pattern": "^path:(?![/~])(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*\\x00)[^/]+(?:/[^/]+)*$", "type": "string"}, "minItems": 1, "type": "array"}
        },
        "required": ["id", "title", "source", "acceptance_criteria", "non_goals", "verification", "write_scope", "dependencies"],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": ["schema_version", "epic_id", "artifact_root", "spec_binding", "approval_evidence", "work_items", "delivery_intent"],
  "title": "Issue Implementation Loop Input Packet",
  "type": "object"
}
