{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Issue Implementation Loop Execution Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "epic_id", "revision", "approved_spec_binding", "epic_base", "execution_policy", "review_policy", "human_policy", "context_policy", "phase_branch_policy", "remote_write_policy", "work_items"],
  "properties": {
    "schema_version": {"const": 4},
    "epic_id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "revision": {"type": "integer", "minimum": 1},
    "approved_spec_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "gate_commit"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/|~)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*\\u0000).+(?<!/)$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "gate_commit": {"type": "string", "pattern": "^[0-9a-f]+$"}
      }
    },
    "repository_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planning_worktree_path", "planning_branch", "planning_base_sha", "default_checkout"],
      "properties": {
        "planning_worktree_path": {"type": "string", "pattern": "^/"},
        "planning_branch": {"type": "string", "pattern": "^codex/[a-z0-9]+(?:-[a-z0-9]+)*/planning$"},
        "planning_base_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "default_checkout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "branch", "head", "status_porcelain_v1"],
          "properties": {
            "path": {"type": "string", "pattern": "^/"},
            "branch": {"type": "string", "minLength": 1},
            "head": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
            "status_porcelain_v1": {"type": "string"}
          }
        }
      }
    },
    "epic_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "sha": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
        "branch_state": {"enum": ["reserved", "create_on_run", "active", "missing"]},
        "worktree_path": {"type": "string"}
      }
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_context_required", "coordinator_may_implement", "serial_fallback_mode"],
      "properties": {
        "parallel_preferred": {"type": "boolean"},
        "serial_fallback_preapproved": {"type": "boolean"},
        "worker_context_required": {"const": true},
        "coordinator_may_implement": {"const": false},
        "serial_fallback_mode": {"const": "worker_context_only"},
        "implementation_slots": {"type": "integer", "minimum": 1},
        "review_slots": {"type": "integer", "minimum": 1},
        "wave_is_barrier": {"type": "boolean"}
      }
    },
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_review_cycles"],
      "properties": {
        "primary": {"type": "string", "minLength": 1},
        "fallbacks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "manual_fallback_preapproved": {"type": "boolean"},
        "max_review_cycles": {"type": "integer", "minimum": 1, "maximum": 2},
        "max_fix_cycles": {"type": "integer", "minimum": 0, "maximum": 2},
        "same_finding_limit": {"type": "integer", "minimum": 1},
        "hardening_candidates": {
          "type": "object",
          "required": [
            "candidate_registry_path",
            "max_candidates_per_issue",
            "max_summary_words",
            "issue_completion_blocking",
            "ready_or_merge_requires_decisions",
            "worker_packet_decision_state"
          ],
          "properties": {
            "candidate_registry_path": {"const": "decisions/hardening-candidates.json"},
            "max_candidates_per_issue": {"type": "integer", "minimum": 1, "maximum": 5},
            "max_summary_words": {"type": "integer", "minimum": 1, "maximum": 80},
            "issue_completion_blocking": {"const": false},
            "ready_or_merge_requires_decisions": {"const": true},
            "worker_packet_decision_state": {"const": "forbidden"}
          },
          "additionalProperties": false
        }
      }
    },
    "human_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_scope", "epic_scope_requires_reason"],
      "properties": {
        "default_scope": {"const": "issue"},
        "epic_scope_requires_reason": {"const": true}
      }
    },
    "context_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths_first", "max_worker_packet_words", "max_worker_report_words", "include_full_spec_text", "include_full_ledger_text", "session_compaction"],
      "properties": {
        "paths_first": {"const": true},
        "max_worker_packet_words": {"type": "integer", "minimum": 1},
        "max_worker_report_words": {"type": "integer", "minimum": 1},
        "include_full_spec_text": {"const": false},
        "include_full_ledger_text": {"const": false},
        "worker_packet_schema": {"type": "string", "minLength": 1},
        "worker_packet_template": {"type": "string", "minLength": 1},
        "worker_packet_validator": {"type": "string", "minLength": 1},
        "session_compaction": {
          "type": "object",
          "required": [
            "soft_trigger_percent",
            "hard_stop_percent",
            "mandatory_handoff_compaction",
            "mandatory_phase_transition_gc",
            "carry_forward_capsule_words_default",
            "carry_forward_capsule_words_hard",
            "inline_json_code_diff_lines_hard"
          ],
          "properties": {
            "soft_trigger_percent": {"const": 65},
            "hard_stop_percent": {"const": 75},
            "mandatory_handoff_compaction": {"const": 1},
            "mandatory_phase_transition_gc": {"const": true},
            "carry_forward_capsule_words_default": {"const": 400},
            "carry_forward_capsule_words_hard": {"const": 600},
            "inline_json_code_diff_lines_hard": {"const": 80}
          },
          "additionalProperties": false
        }
      },
      "dependentRequired": {
        "worker_packet_schema": ["worker_packet_schema", "worker_packet_template", "worker_packet_validator"],
        "worker_packet_template": ["worker_packet_schema", "worker_packet_template", "worker_packet_validator"],
        "worker_packet_validator": ["worker_packet_schema", "worker_packet_template", "worker_packet_validator"]
      }
    },
    "phase_branch_policy": {
      "type": "object",
      "required": [
        "planning_artifacts_branch",
        "phase_approval_commit_required",
        "phase_transition_requires_clean_scope",
        "execution_coordinator_context",
        "main_planning_session_may_implement",
        "worktree_per_issue",
        "branch_prefix",
        "epic_base_ref_pattern",
        "issue_branch_pattern",
        "epic_base_owner",
        "issue_branch_owner",
        "integration_branch_policy"
      ],
      "properties": {
        "planning_artifacts_branch": {"const": "current_session_branch"},
        "phase_approval_commit_required": {"const": true},
        "phase_transition_requires_clean_scope": {"const": true},
        "execution_coordinator_context": {"const": "fresh_or_compacted"},
        "main_planning_session_may_implement": {"const": false},
        "worktree_per_issue": {"const": true},
        "branch_prefix": {"const": "codex"},
        "epic_base_ref_pattern": {"const": "codex/<epic-id>/epic-base"},
        "issue_branch_pattern": {"const": "codex/<epic-id>/<local-id>-<slug>"},
        "epic_base_owner": {"const": "execution_coordinator"},
        "issue_branch_owner": {"const": "worker"},
        "integration_branch_policy": {"const": "approved_integration_work_item_only"}
      },
      "additionalProperties": false
    },
    "remote_write_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "approved_actions"],
      "properties": {
        "mode": {"enum": ["local_only", "per_action", "batch_draft_prs", "batch_issue_prs"]},
        "approved_actions": {
          "type": "array",
          "items": {
            "enum": ["final_pr_push_head", "final_pr_create_draft"]
          },
          "uniqueItems": true
        },
        "issue_prs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base", "merge"],
          "properties": {
            "base": {"const": "epic_base.ref"},
            "merge": {"const": "agent_default_with_human_escalation"}
          }
        },
        "final_pr": {
          "type": "object",
          "required": ["head", "base", "merge"],
          "properties": {
            "head": {"const": "epic_base.ref"},
            "base": {"const": "main"},
            "merge": {"const": "human_only"},
            "draft_default": {"const": true}
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"mode": {"const": "batch_issue_prs"}},
            "required": ["mode"]
          },
          "then": {
            "required": ["issue_prs", "final_pr"]
          }
        },
        {
          "if": {
            "properties": {"mode": {"const": "local_only"}},
            "required": ["mode"]
          },
          "then": {
            "properties": {"approved_actions": {"maxItems": 0}}
          }
        },
        {
          "if": {
            "properties": {"mode": {"not": {"const": "batch_issue_prs"}}},
            "required": ["mode"]
          },
          "then": {
            "not": {
              "anyOf": [
                {"required": ["issue_prs"]},
                {"required": ["final_pr"]}
              ]
            }
          }
        }
      ]
    },
    "work_items": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Z0-9]+-[0-9]+$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "source", "acceptance_criteria", "non_goals", "verification", "branch", "worktree_path", "worktree_state", "base_policy", "write_scope", "dependencies"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "path"],
            "properties": {
              "type": {"const": "local"},
              "path": {"type": "string", "minLength": 1}
            }
          },
          "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "non_goals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "verification": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "branch": {"type": "string", "minLength": 1},
          "worktree_path": {"type": "string", "minLength": 1},
          "worktree_state": {"enum": ["reserved", "create_on_run", "active", "missing"]},
          "base_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": {"enum": ["epic_base", "blocker_head", "integration_head"]},
              "issue": {"type": "string", "minLength": 1},
              "integration_issue": {"type": "string", "minLength": 1}
            }
          },
          "write_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "dependencies": {
            "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
              "required": ["issue", "strength", "release_on", "base_effect"],
              "properties": {
                "issue": {"type": "string", "minLength": 1},
                "strength": {"enum": ["hard", "soft"]},
                "release_on": {"enum": ["artifact_ready", "review_approved", "integrated", "pr_opened", "pr_merged", "human_decision", "external_condition"]},
                "base_effect": {"enum": ["none", "branch_from_blocker_head", "branch_from_integration_head"]}
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "remote_write_policy": {
            "properties": {"mode": {"const": "batch_issue_prs"}},
            "required": ["mode"]
          }
        },
        "required": ["remote_write_policy"]
      },
      "then": {
        "properties": {
          "epic_base": {
            "required": ["ref", "sha", "branch_state"]
          }
        }
      }
    }
  ]
}
