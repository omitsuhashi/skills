{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Issue Implementation Loop Human Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "approved_spec_binding", "id", "scope", "reason"],
  "properties": {
    "schema_version": {"const": 2},
    "approved_spec_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "gate_commit"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "gate_commit": {"type": "string", "pattern": "^[0-9a-f]+$"}
      }
    },
    "id": {"type": "string"},
    "scope": {"enum": ["issue", "descendants", "resource", "epic"]},
    "issue": {"type": "string"},
    "resource": {"type": "string"},
    "reason": {"type": "string"},
    "created_at": {"type": "string"}
  }
}
