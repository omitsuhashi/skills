{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Issue Implementation Loop Runtime State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "epic_id", "envelope_revision", "approved_spec_binding", "issues", "human_requests"],
  "properties": {
    "schema_version": {"const": 2},
    "epic_id": {"type": "string"},
    "envelope_revision": {"type": "integer"},
    "approved_spec_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "gate_commit"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "gate_commit": {"type": "string", "pattern": "^[0-9a-f]+$"}
      }
    },
    "issues": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {"type": "string"},
          "review": {"type": "object"},
          "signals": {"type": "array", "items": {"type": "string"}},
          "branch": {"type": "string"},
          "worktree": {"type": "string"},
          "base_sha": {"type": "string"},
          "head_sha": {"type": "string"},
          "pr": {"type": "string"},
          "pr_opened": {"type": "boolean"},
          "pr_merged": {"type": "boolean"},
          "merge_commit": {"type": "string"}
        },
        "allOf": [
          {
            "if": {
              "properties": {"status": {"enum": ["PR_READY", "COMPLETE", "DONE"]}},
              "required": ["status"]
            },
            "then": {
              "required": ["base_sha", "head_sha", "review"]
            }
          }
        ]
      }
    },
    "human_requests": {
      "type": "array",
      "items": {"$ref": "human-request.schema.json"}
    },
    "rebuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events_applied", "duplicate_events_ignored"],
      "properties": {
        "events_applied": {"type": "integer", "minimum": 0},
        "duplicate_events_ignored": {"type": "integer", "minimum": 0}
      }
    }
  }
}
