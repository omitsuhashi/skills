{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Issue Implementation Loop Worker / Reviewer Dispatch Packet V3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_type", "task_kind", "access_mode", "source_revision", "epic_id", "issue_id", "issue_title", "dispatch_id", "branch", "worktree", "write_scope", "context_policy", "read_paths", "inline_context", "task", "report_contract"],
  "properties": {
    "schema_version": {"const": 3, "default": 3},
    "packet_type": {"const": "issue_worker_dispatch"},
    "task_kind": {"type": "string", "enum": ["implement", "fix", "review", "inspect"]},
    "access_mode": {"type": "string", "enum": ["read_write", "read_only"]},
    "source_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_spec_binding", "execution_envelope", "runtime_state", "issue_source"],
      "properties": {
        "approved_spec_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "gate_commit"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "gate_commit": {"type": "string", "pattern": "^[0-9a-f]+$"}
          }
        },
        "execution_envelope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "revision", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "revision": {"type": "integer", "minimum": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "runtime_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "envelope_revision", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "envelope_revision": {"type": "integer", "minimum": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "issue_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "epic_id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "issue_id": {"type": "string", "pattern": "^[A-Z0-9]+-[0-9]+$"},
    "issue_title": {"type": "string", "minLength": 1},
    "dispatch_id": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "worktree": {"type": "string", "minLength": 1},
    "write_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "context_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths_first", "max_packet_words", "hard_max_packet_words", "max_read_paths", "max_inline_excerpt_words_per_file", "max_inline_excerpt_words_total", "include_full_spec_text", "include_full_ledger_text"],
      "properties": {
        "paths_first": {"const": true},
        "max_packet_words": {"type": "integer", "minimum": 1, "maximum": 800, "default": 450},
        "hard_max_packet_words": {"const": 800},
        "max_read_paths": {"const": 8},
        "max_inline_excerpt_words_per_file": {"const": 120},
        "max_inline_excerpt_words_total": {"const": 300},
        "include_full_spec_text": {"const": false},
        "include_full_ledger_text": {"const": false}
      }
    },
    "read_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "purpose"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "inline_context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "excerpt"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "excerpt": {"type": "string", "minLength": 1},
          "purpose": {"type": "string"},
          "is_full_document": {"const": false}
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "acceptance_criteria", "verification", "stop_conditions"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "verification": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "report_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "validator"],
      "properties": {
        "format": {"type": "string", "minLength": 1},
        "validator": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"task_kind": {"enum": ["implement", "fix"]}}},
      "then": {
        "properties": {
          "access_mode": {"const": "read_write"},
          "write_scope": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"task_kind": {"enum": ["review", "inspect"]}}},
      "then": {
        "properties": {
          "access_mode": {"const": "read_only"},
          "write_scope": {"maxItems": 0}
        }
      }
    }
  ]
}
