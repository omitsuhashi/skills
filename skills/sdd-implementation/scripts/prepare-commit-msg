#!/usr/bin/env python3
from __future__ import annotations

import json
from pathlib import Path
import subprocess
import sys


class GitQueryError(Exception):
    pass


def _git(cwd: Path, *args: str) -> str:
    try:
        result = subprocess.run(
            ["git", *args],
            cwd=cwd,
            capture_output=True,
            check=False,
        )
    except OSError as error:
        raise GitQueryError from error
    if result.returncode != 0:
        raise GitQueryError
    try:
        return result.stdout.decode("utf-8", errors="strict")
    except UnicodeDecodeError as error:
        raise GitQueryError from error


def _canonical_path(value: str, cwd: Path) -> Path:
    path = Path(value)
    if not path.is_absolute():
        path = cwd / path
    try:
        return path.resolve(strict=True)
    except OSError as error:
        raise GitQueryError from error


def _worktree_records(output: str) -> list[dict[str, list[str]]]:
    records: list[dict[str, list[str]]] = []
    for raw_record in output.split("\0\0"):
        if not raw_record:
            continue
        record: dict[str, list[str]] = {}
        for field in raw_record.split("\0"):
            if not field:
                continue
            key, separator, value = field.partition(" ")
            if not separator:
                value = ""
            record.setdefault(key, []).append(value)
        records.append(record)
    return records


def checkout_verdict(cwd: Path) -> tuple[bool, str]:
    try:
        toplevel = _canonical_path(_git(cwd, "rev-parse", "--show-toplevel").strip(), cwd)
        git_dir = _canonical_path(_git(cwd, "rev-parse", "--absolute-git-dir").strip(), cwd)
        common_dir = _canonical_path(
            _git(
                cwd,
                "rev-parse",
                "--path-format=absolute",
                "--git-common-dir",
            ).strip(),
            cwd,
        )
    except GitQueryError:
        return False, "git checkout identity unavailable"

    if git_dir == common_dir:
        return False, "primary checkout rejected"

    registrations_dir = common_dir / "worktrees"
    if git_dir.parent != registrations_dir or not git_dir.name:
        return False, "linked worktree registration unavailable"

    try:
        symbolic_ref = _git(cwd, "symbolic-ref", "--quiet", "HEAD").strip()
        head = _git(cwd, "rev-parse", "--verify", "HEAD").strip()
    except GitQueryError:
        return False, "detached HEAD or symbolic branch unavailable"
    if not symbolic_ref.startswith("refs/heads/") or not symbolic_ref.removeprefix(
        "refs/heads/"
    ):
        return False, "symbolic branch unavailable"

    backlink = git_dir / "gitdir"
    try:
        backlink_lines = backlink.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError):
        return False, "linked worktree backlink unavailable"
    if len(backlink_lines) != 1 or not backlink_lines[0]:
        return False, "linked worktree backlink ambiguous"
    try:
        backlink_path = _canonical_path(backlink_lines[0], git_dir)
        expected_backlink = (toplevel / ".git").resolve(strict=True)
    except (GitQueryError, OSError):
        return False, "linked worktree backlink unavailable"
    if backlink_path != expected_backlink:
        return False, "linked worktree backlink mismatch"

    try:
        records = _worktree_records(_git(cwd, "worktree", "list", "--porcelain", "-z"))
    except GitQueryError:
        return False, "worktree registration query failed"

    matches = 0
    for record in records:
        if (
            len(record.get("worktree", [])) != 1
            or len(record.get("HEAD", [])) != 1
            or len(record.get("branch", [])) != 1
        ):
            continue
        try:
            record_toplevel = _canonical_path(record["worktree"][0], cwd)
        except GitQueryError:
            continue
        if (
            record_toplevel == toplevel
            and record["HEAD"][0] == head
            and record["branch"][0] == symbolic_ref
        ):
            matches += 1

    if matches != 1:
        return False, "worktree registration record mismatch"
    return True, "registered linked worktree"


def main(argv: list[str]) -> int:
    allowed, reason = checkout_verdict(Path.cwd())
    if argv[1:] == ["--self-check"]:
        print(
            json.dumps(
                {"allowed": allowed, "reason": reason},
                sort_keys=True,
                separators=(",", ":"),
            )
        )
    elif not allowed:
        print(f"SDD commit guard: {reason}", file=sys.stderr)
    return 0 if allowed else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
